<section class="rc-products"><div class="rc-section-head"><div><p class="rc-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.collection %}<a href="{{ section.settings.collection.url }}">VIEW ALL →</a>{% endif %}</div>{% assign source = section.settings.collection %}<div class="rc-product-grid">{% if source != blank %}{% for product in source.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% else %}<p>Select a collection in the theme editor.</p>{% endif %}</div></section>{% schema %}{"name":"Product Rail","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"04 / COLLECTION"},{"type":"text","id":"heading","label":"Heading","default":"MEN'S WATCHES"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":6}],"presets":[{"name":"Product Rail"}]}{% endschema %}