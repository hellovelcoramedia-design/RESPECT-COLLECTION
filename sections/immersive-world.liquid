<section class="rc-world" data-3d-stage data-world="{{ section.settings.world }}"><div class="rc-world-copy"><p class="rc-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="rc-btn" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.button }}</a></div><div class="rc-world-stage"><canvas data-3d-canvas aria-label="Interactive 3D {{ section.settings.world }}"></canvas>{% if section.settings.fallback %}<div class="rc-3d-fallback" style="background-image:url('{{ section.settings.fallback | image_url: width: 1400 }}')"></div>{% endif %}</div></section>{% schema %}{"name":"Immersive 3D World","settings":[{"type":"select","id":"world","label":"World","options":[{"value":"watch","label":"Watch"},{"value":"bag","label":"Bag"},{"value":"fragrance","label":"Fragrance"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EXPERIENCE"},{"type":"text","id":"heading","label":"Heading","default":"TIME, REFINED."},{"type":"textarea","id":"text","label":"Text","default":"Precision, material and craft in one considered object."},{"type":"text","id":"button","label":"Button","default":"EXPLORE"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"fallback","label":"Fallback image"}],"presets":[{"name":"Immersive 3D World"}]}{% endschema %}