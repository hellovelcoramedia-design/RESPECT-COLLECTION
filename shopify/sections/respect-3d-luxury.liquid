{% comment %}
RESPECT COLLECTION — Premium 3D Shopify OS 2.0 section
Uses native Shopify Liquid + CSS + vanilla JS. No external app required.
{% endcomment %}
<section class="rc3d" data-rc3d>
  <div class="rc3d__ambient"></div>
  <div class="rc3d__nav">
    <a class="rc3d__brand" href="{{ routes.root_url }}">RESPECT <span>COLLECTION</span></a>
    <div class="rc3d__links"><a href="{{ routes.collections_url }}/watches">WATCHES</a><a href="{{ routes.collections_url }}/bags">BAGS</a><a href="{{ routes.collections_url }}/fragrance">FRAGRANCE</a></div>
    <button class="rc3d__bag" type="button" data-open-cart> BAG <b>{{ cart.item_count }}</b></button>
  </div>

  <div class="rc3d__hero">
    <div class="rc3d__hero-copy">
      <p class="eyebrow">RESPECT COLLECTION · 2026</p>
      <h1>DEFINED<br><em>BY PRESENCE.</em></h1>
      <p class="lede">A new expression of modern luxury. Sculpted objects, quiet confidence and a signature designed to remain.</p>
      <div class="actions"><a class="btn btn--light" href="{{ routes.collections_url }}/all">EXPLORE COLLECTION <span>↗</span></a><a class="text-link" href="#the-house">DISCOVER THE HOUSE</a></div>
    </div>
    <div class="rc3d__orb" data-tilt>
      <div class="orb__ring orb__ring--1"></div><div class="orb__ring orb__ring--2"></div>
      {% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 1400 }}" alt="{{ section.settings.hero_image.alt | escape }}" loading="eager">{% else %}<div class="orb__placeholder">R</div>{% endif %}
      <span class="orb__word">RESPECT</span>
    </div>
    <div class="rc3d__scroll">SCROLL TO EXPLORE <span>↓</span></div>
  </div>

  <div class="rc3d__marquee"><div>TIME · FORM · SCENT · PRESENCE · TIME · FORM · SCENT · PRESENCE · </div></div>

  <div id="the-house" class="rc3d__manifesto">
    <p class="eyebrow">THE HOUSE</p><h2>LUXURY IS<br><em>FELT.</em></h2>
    <p>We design fewer things, better. Every object is shaped around proportion, material, tactility and the confidence to leave space.</p>
  </div>

  {% assign watch_collection = collections['watches'] %}{% assign bag_collection = collections['bags'] %}{% assign frag_collection = collections['fragrance'] %}
  <div class="rc3d__collections">
    {% for c in section.settings.featured_collections %}{% assign fc = collections[c.handle] %}{% if fc %}
      <a class="rc-card" href="{{ fc.url }}" style="--image:url('{{ fc.featured_image | image_url: width: 1200 }}')"><span class="rc-card__index">0{{ forloop.index }}</span><div><p>{{ fc.title }}</p><h3>{{ fc.description | default: 'CONSIDERED OBJECTS.' }}</h3><span>EXPLORE ↗</span></div></a>
    {% endif %}{% endfor %}
  </div>

  <div class="rc3d__products">
    <div class="section-head"><div><p class="eyebrow">THE EDIT</p><h2>SELECTED<br><em>OBJECTS.</em></h2></div><a href="{{ routes.collections_url }}/all">VIEW ALL ↗</a></div>
    <div class="product-grid">{% assign shown = 0 %}{% for product in collections.all.products limit: 8 %}<article class="product-card"><a href="{{ product.url }}"><div class="product-card__image">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}">{% endif %}<span>VIEW</span></div><p>{{ product.type | default: 'RESPECT COLLECTION' }}</p><h3>{{ product.title }}</h3><strong>{{ product.price | money }}</strong></a><button class="add" data-add="{{ product.selected_or_first_available_variant.id }}">ADD TO BAG</button></article>{% endfor %}</div>
  </div>

  <div class="rc3d__quote"><span>“</span><p>True luxury does not ask to be noticed.<br><em>It is remembered.</em></p><small>RESPECT COLLECTION</small></div>

  <div class="rc3d__newsletter"><div><p class="eyebrow">PRIVATE CLIENT LIST</p><h2>STAY<br><em>IN PRESENCE.</em></h2></div>{% form 'customer', class:'rc-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input required type="email" name="contact[email]" placeholder="EMAIL ADDRESS"><button type="submit">JOIN ↗</button>{% endform %}</div>

  <aside class="rc-cart" data-cart><button class="rc-cart__close" data-close-cart>×</button><p class="eyebrow">YOUR BAG</p><h2>THE EDIT.</h2><div data-cart-items></div><div class="rc-cart__footer"><div><span>SUBTOTAL</span><b data-cart-total>{{ cart.total_price | money }}</b></div><a href="{{ routes.cart_url }}">CHECKOUT ↗</a></div></aside>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
.rc3d{--ink:#f3efe7;--dark:#090a09;--gold:#b9a47b;background:var(--dark);color:var(--ink);font-family:'DM Sans',sans-serif;overflow:hidden}.rc3d *{box-sizing:border-box}.rc3d a{color:inherit;text-decoration:none}.eyebrow{font-size:9px;letter-spacing:.3em;opacity:.62}.rc3d__nav{position:absolute;z-index:20;top:0;left:0;width:100%;height:82px;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #fff2;backdrop-filter:blur(16px);background:#08090866}.rc3d__brand{font-size:12px;letter-spacing:.3em}.rc3d__brand span{opacity:.5}.rc3d__links{display:flex;gap:38px;font-size:9px;letter-spacing:.24em}.rc3d__bag{border:0;background:none;color:inherit;font-size:9px;letter-spacing:.2em}.rc3d__bag b{margin-left:8px;font-weight:400}.rc3d__hero{min-height:100vh;position:relative;display:flex;align-items:center;padding:120px 7vw;background:radial-gradient(circle at 68% 48%,#302f2b 0,#11120f 28%,#080908 65%)}.rc3d__hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#050605dd 0%,transparent 60%);pointer-events:none}.rc3d__hero-copy{position:relative;z-index:5;width:46%;max-width:650px}.rc3d h1,.rc3d h2,.rc3d h3{font-family:'Playfair Display',serif;font-weight:400}.rc3d h1{font-size:clamp(60px,8.7vw,145px);line-height:.82;letter-spacing:-.05em;margin:20px 0}.rc3d em{font-style:italic}.lede{max-width:420px;color:#fff9;line-height:1.8;font-size:14px}.actions{display:flex;align-items:center;gap:28px;margin-top:38px}.btn{padding:16px 22px;font-size:9px;letter-spacing:.2em}.btn--light{background:var(--ink);color:#111}.text-link{font-size:9px;letter-spacing:.18em;border-bottom:1px solid #fff6;padding-bottom:7px}.rc3d__orb{position:absolute;z-index:3;right:7%;top:18%;width:min(54vw,700px);height:min(54vw,700px);border-radius:50%;transform-style:preserve-3d;transition:transform .15s ease;filter:drop-shadow(0 45px 65px #000)}.rc3d__orb img{width:100%;height:100%;object-fit:cover;border-radius:50%;opacity:.84;mix-blend-mode:screen}.orb__placeholder{width:100%;height:100%;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 25%,#d2c9b5,#45433d 30%,#0b0c0b 68%);font:italic 230px 'Playfair Display';box-shadow:inset -40px -40px 100px #000,inset 20px 20px 60px #fff2}.orb__ring{position:absolute;inset:-5%;border:1px solid #b9a47b66;border-radius:50%;transform:rotateX(72deg) rotateZ(12deg)}.orb__ring--2{inset:8%;transform:rotateY(72deg) rotateZ(-20deg);border-color:#fff3}.orb__word{position:absolute;bottom:18%;left:13%;font-size:8px;letter-spacing:.5em;opacity:.7}.rc3d__scroll{position:absolute;bottom:35px;left:7vw;z-index:5;font-size:8px;letter-spacing:.25em;color:#fff8}.rc3d__scroll span{margin-left:14px}.rc3d__marquee{height:72px;display:flex;align-items:center;overflow:hidden;border-block:1px solid #fff1;font:italic 28px 'Playfair Display';white-space:nowrap}.rc3d__marquee div{animation:marquee 28s linear infinite}@keyframes marquee{to{transform:translateX(-50%)}}.rc3d__manifesto{padding:170px 12vw;display:grid;grid-template-columns:1fr 1fr;gap:8vw;background:#e9e3d8;color:#111}.rc3d__manifesto h2{font-size:clamp(65px,9vw,140px);line-height:.78;margin:18px 0}.rc3d__manifesto>p:last-child{align-self:end;max-width:430px;line-height:2;color:#1119;font-size:15px}.rc3d__collections{display:grid;grid-template-columns:repeat(3,1fr);min-height:75vh}.rc-card{min-height:650px;padding:38px;display:flex;align-items:flex-end;position:relative;isolation:isolate;background-image:linear-gradient(0deg,#050505dd,transparent 60%),var(--image);background-size:cover;background-position:center;transition:transform .7s,filter .7s}.rc-card:after{content:'';position:absolute;inset:0;background:#0000;transition:.5s}.rc-card:hover{transform:scale(.985)}.rc-card:hover:after{background:#0004}.rc-card>div,.rc-card__index{position:relative;z-index:2}.rc-card__index{position:absolute;top:35px;left:38px;font-size:9px;opacity:.6}.rc-card p{font-size:9px;letter-spacing:.3em}.rc-card h3{font-size:42px;line-height:.95;max-width:350px;margin:12px 0 25px}.rc-card div span{font-size:8px;letter-spacing:.2em}.rc3d__products{padding:150px 6vw;background:#f0ece3;color:#111}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:55px}.section-head h2{font-size:70px;line-height:.8;margin-top:14px}.section-head>a{font-size:9px;letter-spacing:.2em;border-bottom:1px solid #111;padding-bottom:7px}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product-card__image{aspect-ratio:4/5;overflow:hidden;background:#ded8cc;position:relative}.product-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .8s}.product-card:hover img{transform:scale(1.07)}.product-card__image span{position:absolute;bottom:14px;right:14px;background:#111;color:#fff;padding:10px 12px;font-size:8px;letter-spacing:.15em;opacity:0;transform:translateY(8px);transition:.3s}.product-card:hover .product-card__image span{opacity:1;transform:none}.product-card p{font-size:8px;letter-spacing:.18em;opacity:.5;margin:17px 0 7px}.product-card h3{font-size:22px;margin:0 0 5px}.product-card strong{font-size:11px;font-weight:500}.add{margin-top:18px;width:100%;padding:13px;background:#111;color:#fff;border:0;font-size:8px;letter-spacing:.2em;cursor:pointer}.rc3d__quote{padding:180px 8vw;text-align:center;background:#111;color:#f0ece3}.rc3d__quote span{font:100px 'Playfair Display';opacity:.35}.rc3d__quote p{font:clamp(35px,5vw,75px) 'Playfair Display';line-height:1.05}.rc3d__quote small{display:block;margin-top:35px;font-size:8px;letter-spacing:.3em;opacity:.5}.rc3d__newsletter{padding:130px 8vw;display:grid;grid-template-columns:1fr 1fr;gap:10vw;background:#c9c0af;color:#111}.rc3d__newsletter h2{font-size:80px;line-height:.82;margin-top:15px}.rc-form{display:flex;align-items:end;border-bottom:1px solid #111;padding-bottom:13px;align-self:end}.rc-form input{background:none;border:0;outline:0;flex:1;font:18px 'DM Sans';letter-spacing:.08em}.rc-form button{border:0;background:none;font-size:9px;letter-spacing:.2em}.rc-cart{position:fixed;z-index:99;right:0;top:0;height:100%;width:min(440px,100%);background:#f0ece3;color:#111;padding:40px;transform:translateX(110%);transition:transform .5s;box-shadow:-20px 0 70px #0004}.rc-cart.is-open{transform:none}.rc-cart__close{float:right;background:none;border:0;font-size:30px}.rc-cart h2{font-size:55px;margin:20px 0 30px}.rc-cart__footer{position:absolute;bottom:35px;left:40px;right:40px}.rc-cart__footer div{display:flex;justify-content:space-between;padding:18px 0;border-top:1px solid #1113;font-size:9px;letter-spacing:.15em}.rc-cart__footer a{display:block;background:#111;color:#fff;text-align:center;padding:18px;font-size:9px;letter-spacing:.2em}
@media(max-width:800px){.rc3d__links{display:none}.rc3d__hero{padding:120px 24px 60px;min-height:900px}.rc3d__hero-copy{width:100%;align-self:flex-end}.rc3d__orb{width:86vw;height:86vw;top:120px;right:7%}.rc3d__hero:after{background:linear-gradient(0deg,#050605f5 10%,transparent 75%)}.rc3d h1{font-size:58px}.actions{flex-wrap:wrap}.rc3d__manifesto{grid-template-columns:1fr;padding:100px 25px}.rc3d__collections{grid-template-columns:1fr}.rc-card{min-height:520px}.product-grid{grid-template-columns:repeat(2,1fr);gap:10px}.rc3d__products{padding:90px 18px}.section-head h2{font-size:48px}.rc3d__newsletter{grid-template-columns:1fr;padding:90px 25px}.rc3d__newsletter h2{font-size:58px}.rc-form{margin-top:60px}.rc3d__quote{padding:120px 25px}.rc3d__nav{padding:0 20px}}
</style>
<script>
(()=>{const root=document.querySelector('[data-rc3d]');if(!root)return;const orb=root.querySelector('[data-tilt]');root.addEventListener('mousemove',e=>{if(!orb)return;const r=orb.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;orb.style.transform=`perspective(1000px) rotateX(${y*-7}deg) rotateY(${x*9}deg) rotateZ(${x*2}deg)`});root.addEventListener('mouseleave',()=>{if(orb)orb.style.transform=''});const cart=root.querySelector('[data-cart]');root.querySelectorAll('[data-open-cart]').forEach(b=>b.onclick=()=>{cart.classList.add('is-open');renderCart()});root.querySelector('[data-close-cart]').onclick=()=>cart.classList.remove('is-open');root.querySelectorAll('[data-add]').forEach(b=>b.onclick=async()=>{b.disabled=true;await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:Number(b.dataset.add),quantity:1}]})});b.disabled=false;cart.classList.add('is-open');renderCart()});async function renderCart(){const d=await fetch('/cart.js').then(r=>r.json());root.querySelector('[data-cart-total]').innerHTML=(d.total_price/100).toLocaleString(undefined,{style:'currency',currency:'{{ shop.currency }}'});root.querySelector('[data-cart-items]').innerHTML=d.items.map(i=>`<div style="display:flex;gap:14px;border-bottom:1px solid #1112;padding:15px 0"><img src="${i.image}" style="width:65px;height:80px;object-fit:cover"><div><b style="font:18px Playfair Display">${i.product_title}</b><p style="font-size:11px;margin-top:8px">${i.quantity} × ${i.final_price/100} {{ shop.currency }}</p></div></div>`).join('')||'<p style="opacity:.5;font-size:13px">Your bag is empty.</p>'}}
})();
</script>
{% schema %}{"name":"RESPECT 3D Luxury","settings":[{"type":"image_picker","id":"hero_image","label":"Hero product / campaign image"},{"type":"collection_list","id":"featured_collections","label":"Featured collections","limit":3}],"presets":[{"name":"RESPECT 3D Luxury"}]}{% endschema %}