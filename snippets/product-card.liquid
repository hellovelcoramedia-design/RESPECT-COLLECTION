<article class="rc-card"><a href="{{ product.url }}"><div class="rc-card-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" loading="lazy" alt="{{ product.featured_image.alt | default: product.title | escape }}">{% endif %}</div><div class="rc-card-info"><h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></div></a><div class="rc-card-actions"><button type="button" data-quick-view="{{ product.handle }}">QUICK VIEW</button><button type="button" data-add="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>{% if product.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</button></div></article>