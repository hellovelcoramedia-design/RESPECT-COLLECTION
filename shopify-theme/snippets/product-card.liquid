<article class="rc-card"><a href="{{ product.url }}"><div class="rc-card-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" loading="lazy" alt="{{ product.featured_image.alt | default: product.title | escape }}">{% endif %}{% if product.images[1] %}<img class="rc-second" src="{{ product.images[1] | image_url: width: 1000 }}" loading="lazy" alt="">{% endif %}<span class="rc-card-badge">{{ product.type | default: 'Signature' }}</span></div><div class="rc-card-info"><h3>{{ product.title }}</h3><p>{{ product.price | money }}</p></div></a><button class="rc-quick" data-add="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button></article>