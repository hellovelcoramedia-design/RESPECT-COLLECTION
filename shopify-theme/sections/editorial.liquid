<section class="rc-editorial"><div class="rc-editorial-media">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">{% endif %}</div><div class="rc-editorial-copy"><p class="rc-kicker">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><a class="rc-btn" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.button }}</a></div></section>{% schema %}{"name":"Editorial Campaign","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"06 / EDITORIAL"},{"type":"text","id":"heading","label":"Heading","default":"THE NEW STANDARD."},{"type":"image_picker","id":"image","label":"Campaign image"},{"type":"text","id":"button","label":"Button","default":"DISCOVER"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Editorial Campaign"}]}{% endschema %}