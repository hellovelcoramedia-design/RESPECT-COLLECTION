<section class="rc-collections"><div class="rc-section-head"><p class="rc-kicker">02 / SIGNATURE WORLDS</p><h2>Choose your <i>presence.</i></h2></div><div class="rc-collection-grid">{% assign featured = section.settings.collections %}{% for collection in featured %}<a class="rc-collection-card" href="{{ collection.url }}">{% if collection.image %}<img src="{{ collection.image | image_url: width: 1200 }}" loading="lazy" alt="{{ collection.title | escape }}">{% endif %}<div><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ collection.title }}</h3><b>Explore ↗</b></div></a>{% endfor %}</div></section>{% schema %}{"name":"Collection worlds","settings":[{"type":"collection_list","id":"collections","label":"Collections","limit":3}],"presets":[{"name":"Signature worlds"}]}{% endschema %}