<section class="rc-search"><div class="rc-collection-title"><p class="rc-kicker">SEARCH</p><h1>Find your piece.</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search watches, bags, fragrance..."><button class="rc-btn">Search ↗</button></form></div>{% if search.performed %}<div class="rc-product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}{% endfor %}</div>{% endif %}</section>