<section class="rc-main-product"><div class="rc-product-gallery">{% for image in product.images %}<img src="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">{% endfor %}</div><div class="rc-product-copy"><p class="rc-kicker">{{ product.type | default: 'RESPECT OBJECT' }}</p><h1>{{ product.title }}</h1><div class="rc-price">{{ product.price | money }}</div>{% if product.description %}<div class="rc-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'rc-buy-form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label>Quantity<input name="quantity" type="number" min="1" value="1"></label><button class="rc-btn rc-buy" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag — {{ product.price | money }}{% else %}Sold out{% endif %}</button>{% endform %}<div class="rc-product-trust"><p>✓ Secure Shopify checkout</p><p>✓ Tracked worldwide delivery</p><p>✓ Support from the RESPECT team</p></div></div></section>