<section class="rc-cart"><div class="rc-section-head"><p class="rc-kicker">YOUR BAG</p><h1>Selected with intent.</h1></div>{% if cart.item_count == 0 %}<p>Your bag is waiting.</p><a class="rc-btn" href="{{ routes.collections_url }}/all">Explore the collection</a>{% else %}{% for item in cart.items %}<div class="rc-cart-item"><img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.title | escape }}"><div><h3>{{ item.product.title }}</h3><p>{{ item.final_line_price | money }}</p><a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0">Remove</a></div></div>{% endfor %}<div class="rc-total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div><form action="{{ routes.cart_url }}" method="post"><button class="rc-btn" name="checkout" type="submit">Secure checkout ↗</button></form>{% endif %}</section>