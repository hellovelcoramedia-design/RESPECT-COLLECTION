{% assign collection = section.settings.collection %}<section class="rc-products"><div class="rc-section-head"><p class="rc-kicker">03 / CURATED FOR YOU</p><h2>{{ section.settings.heading }}</h2><a href="{{ collection.url }}">View all ↗</a></div><div class="rc-product-grid">{% for product in collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div></section>{% schema %}{"name":"Product showcase","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Heading","default":"The pieces people remember."},{"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Curated products"}]}{% endschema %}